# The image tools/run_linux.sh and tools/play_linux.sh run the desktop program in: the build image (Dockerfile.linux,
# passed as BASE, which has lavapipe) plus xdotool, to press the game's keys.
ARG BASE
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends xdotool && rm -rf /var/lib/apt/lists/*
